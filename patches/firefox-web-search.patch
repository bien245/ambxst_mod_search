+        function openWebSearch() {
+            let query = searchText.trim();
+            if (!query)
+                return;
+
+            // Nếu nhập URL hoặc tên miền, mở thẳng trang web.
+            let isDomain = /^(localhost|(?:[a-z0-9](?:[a-z0-9-]*[a-z0-9])?\.)+[a-z]{2,})(?::\d{1,5})?(?:[/?#][^\s]*)?$/i.test(query);
+            let url;
+
+            if (/^https?:\/\//i.test(query)) {
+                url = query;
+            } else if (isDomain) {
+                url = "https://" + query;
+            } else {
+                url = "https://www.google.com/search?q=" + encodeURIComponent(query);
+            }
+
+            globalOpenProcess.command = ["xdg-open", url];
+            globalOpenProcess.running = true;
+            Visibilities.setActiveModule("");
+        }
+
+        function refreshWebSearchRow() {
+            for (let i = appsModel.count - 1; i >= 0; i--) {
+                if (appsModel.get(i).isWebSearch)
+                    appsModel.remove(i);
+            }
+
+            let query = searchText.trim();
+            if (query.length > 0) {
+                appsModel.append({
+                    appId: "__ambxst_web_search__",
+                    appName: "Search web: " + query,
+                    appIcon: "firefox",
+                    appComment: "Search with Firefox's default search engine",
+                    appExecString: "",
+                    appCategories: [],
+                    appRunInTerminal: false,
+                    isWebSearch: true
+                });
             }
